<div class="star-trail" aria-hidden="true"></div>

<script>
	const trail = document.querySelector('.star-trail');

	let lastTime = 0;

	document.addEventListener('pointermove', (event) => {
		const now = Date.now();

		if (now - lastTime < 120) return;
		lastTime = now;

		if (!trail) return;

		const star = document.createElement('span');

		star.className = 'cursor-star';
		star.textContent = '⭐';

		star.style.left = `${event.clientX}px`;
		star.style.top = `${event.clientY}px`;

		const size = 12 + Math.random() * 14;
		star.style.fontSize = `${size}px`;

		const rotation = Math.random() * 60 - 30;
		star.style.setProperty('--rotation', `${rotation}deg`);

		trail.appendChild(star);

		setTimeout(() => {
			star.remove();
		}, 700);
	});
</script>

<style>
	.star-trail {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 9999;
		overflow: hidden;
	}

	.cursor-star {
		position: fixed;
		transform: translate(-50%, -50%) rotate(var(--rotation));
		pointer-events: none;
		animation: star-fade 700ms ease-out forwards;
		user-select: none;
	}

	@keyframes star-fade {
		0% {
			opacity: 1;
			transform: translate(-50%, -50%) rotate(var(--rotation)) scale(1);
		}

		100% {
			opacity: 0;
			transform: translate(-50%, -90%) rotate(calc(var(--rotation) + 30deg)) scale(0.3);
		}
	}

	@media (max-width: 768px) {
		.star-trail {
			display: none;
		}
	}
</style>